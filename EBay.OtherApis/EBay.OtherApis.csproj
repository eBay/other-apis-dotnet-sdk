<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EBay.OtherApis</RootNamespace>
    <AssemblyName>EBay.OtherApis</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EBay.OtherApis</PackageId>
    <Version>0.3.0</Version>
    <Authors>eBay</Authors>
    <Description>Other APIs SDK for eBay</Description>
    <PackageProjectUrl>https://github.com/eBay/other-apis-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eBay/other-apis-dotnet-sdk</RepositoryUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- REST: Kiota runtime -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.22.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
  </ItemGroup>

</Project>
